# Cardano NFT Floor Price Service Configuration
# Copy to .env and fill in your values

# Required: TapTools API key
TAPTOOLS_API_KEY=your_taptools_api_key_here

# Optional: Update frequency (default: 15 minutes = 4 calls/hour)
UPDATE_INTERVAL_MINUTES=15

# Optional: API calls per update cycle (default: 1)
CALLS_PER_UPDATE=1
