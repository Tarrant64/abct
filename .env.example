# OPTIONAL: Token Logo Service
#-------------------------------------------------------------------------------
# Get your publishable key at: https://logokit.com
# Required for: Crypto token logo images throughout the UI
LOGOKIT_API_KEY=

#-------------------------------------------------------------------------------
# OPTIONAL: NFT Image Caching
#-------------------------------------------------------------------------------
# Enable local caching of NFT images for faster loading
# Images are stored in data/nft_images.db (separate from main database)
NFT_IMAGE_CACHE_ENABLED=false
NFT_IMAGE_MAX_SIZE_MB=5
NFT_IMAGE_THUMBNAIL_SIZE=150

#-------------------------------------------------------------------------------
# OPTIONAL: NFT Background Scheduler (v0.9.0+)
#-------------------------------------------------------------------------------
# Automatically collect Cardano NFT floor prices in the background
# Spreads API calls across 24 hours to respect TapTools rate limits (100/day)
#
# Enable the scheduler (default: false)
# When enabled, scheduler runs every 15 minutes updating collections
NFT_SCHEDULER_ENABLED=false

# How often to run update cycles (in minutes)
# Default: 15 minutes = 96 updates per day
NFT_UPDATE_INTERVAL_MINUTES=15

# Collections to update per cycle
# Default: 1 collection = respects rate limits comfortably
# Max recommended: 4 (for faster updates if you have few collections)
NFT_CALLS_PER_UPDATE=1

# Daily API call safety limit (max 100, default 95 for buffer)
# Scheduler stops when this limit is reached and resumes next day
NFT_MAX_DAILY_CALLS=95

#-------------------------------------------------------------------------------
# SECURITY SETTINGS (v0.8.0+)
#-------------------------------------------------------------------------------
# SSL/HTTPS Configuration
# Options: http | https-self-signed | https-custom
ABCT_SSL_MODE=http

# Paths to SSL certificate and key (for https-custom mode)
# ABCT_SSL_CERT=/path/to/cert.pem
# ABCT_SSL_KEY=/path/to/key.pem

# Authentication (v0.10.0+)
# Disable authentication for localhost-only development (default: requires auth)
# WARNING: Only set to false on trusted localhost installations
ABCT_REQUIRE_AUTH=false

# Admin credentials (required if ABCT_REQUIRE_AUTH is not false)
# Used for login page and sensitive operations (backup/restore, etc.)
#
# Default credentials (change immediately after first login!):
#   Username: admin
#   Password: satoshi
#
# To set a custom password, uncomment and set ABCT_ADMIN_PASSWORD:
# ABCT_ADMIN_PASSWORD=your_secure_password_here
#
# You can also change the password using the reset script:
#   python scripts/password_reset.py
#
# For more details, see PASSWORD_RESET_GUIDE.md

# Encryption key for API keys at rest (auto-generated if not provided)
# Generate with: openssl rand -base64 32
# ABCT_ENCRYPTION_KEY=base64_encoded_32_byte_key

# Network binding (default: 127.0.0.1 for localhost-only)
# WARNING: Setting to 0.0.0.0 exposes service on network - use with auth + HTTPS
BIND_HOST=127.0.0.1
BIND_PORT=8000

# CORS Configuration (for microservices)
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Logging Configuration
# ENABLE_AUDIT_LOG=true
# LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
