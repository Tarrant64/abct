#===============================================================================
# ABCT Configuration - API Keys Example
#===============================================================================
#
# Copy this file to .env and add your API keys:
#   cp .env.example .env
#   nano .env
#
# IMPORTANT: Never commit .env to version control!
#
#===============================================================================

#-------------------------------------------------------------------------------
# REQUIRED: Cardano Blockchain API
#-------------------------------------------------------------------------------
# Get your free API key at: https://blockfrost.io
# Required for: Tracking Cardano wallets and native assets
BLOCKFROST_API_KEY=mainnetXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

#-------------------------------------------------------------------------------
# RECOMMENDED: Cardano Staking Data
#-------------------------------------------------------------------------------
# Get your API key at: https://cexplorer.io/api
# Required for: Viewing staking positions and rewards
CEXPLORER_API_KEY=

#-------------------------------------------------------------------------------
# OPTIONAL: Cardano NFT Floor Prices
#-------------------------------------------------------------------------------
# Get your API key at: https://www.taptools.io/openapi/subscription
# Required for: Cardano NFT floor price data
TAPTOOLS_API_KEY=

#-------------------------------------------------------------------------------
# OPTIONAL: Ethereum Support
#-------------------------------------------------------------------------------
# Get your API key at: https://etherscan.io/apis
# Required for: Tracking Ethereum wallets
ETHERSCAN_API_KEY=

#-------------------------------------------------------------------------------
# OPTIONAL: Multi-Chain EVM Support
#-------------------------------------------------------------------------------
# Alchemy: ETH, Polygon, Base, BSC, Arbitrum, Avalanche, Optimism, zkSync, Linea, Scroll
# Get your API key at: https://dashboard.alchemy.com
ALCHEMY_API_KEY=

# Helius: Solana RPC + NFTs
# Get your API key at: https://www.helius.dev
HELIUS_API_KEY=

# Moralis: Multi-chain fallback
# Get your API key at: https://moralis.io
MORALIS_API_KEY=

# CoinMarketCap: Secondary pricing
# Get your API key at: https://coinmarketcap.com/api
CMC_API_KEY=

# The Graph: Uniswap data
# Get your API key at: https://thegraph.com
GRAPH_API_KEY=

#-------------------------------------------------------------------------------
# Note: Coinbase Integration
#-------------------------------------------------------------------------------
# Coinbase uses a separate JSON file for API keys.
#
# 1. Go to https://portal.cdp.coinbase.com/access/api
# 2. Create a new API key with "View" permissions
# 3. Download the JSON file
# 4. Save it as cdp_api_key.json in the project root
#

