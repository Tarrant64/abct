                <TD></TD>
            </TR>
        </TABLE>
    >];

    // ========== LAYOUT CONNECTIONS ==========

    // Row 1: Hub to blockchain groups
    hub -> chains_l1 [color="#06B6D4", label="  /wallets  "];
    hub -> chains_evm [color="#818CF8", label="  /wallets  "];

    // Force L1 and EVM side by side
    {rank=same; chains_l1; chains_evm}

    // Row 2: Alt + Other chains
    chains_l1 -> chains_alt [style=invis];
    chains_evm -> chains_other [style=invis];
    {rank=same; chains_alt; chains_other}

    // Row 3: NFTs + Exchanges + Pricing
    hub -> nfts [color="#F59E0B", label="  /nfts  "];
    hub -> exchanges [color="#3B82F6", label="  /exchanges  "];
    hub -> pricing [color="#EC4899", label="  /prices  "];
    {rank=same; nfts; exchanges; pricing}

    // Row 4: Support + Demo + Infra
    nfts -> support [style=invis];
    exchanges -> demo [style=invis];
    pricing -> infra [style=invis];
    {rank=same; support; demo; infra}
}
