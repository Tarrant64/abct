                <TD BGCOLOR="#0F2832"><FONT COLOR="#0098EA"><B>TON</B></FONT><BR/><FONT POINT-SIZE="7" COLOR="#64748B">TonCenter</FONT></TD>
                <TD BGCOLOR="#0F2832"><FONT COLOR="#E6007A"><B>Polkadot</B></FONT><BR/><FONT POINT-SIZE="7" COLOR="#64748B">Subscan</FONT></TD>
                <TD BGCOLOR="#0F2832"><FONT COLOR="#E6007A"><B>Kusama</B></FONT><BR/><FONT POINT-SIZE="7" COLOR="#64748B">Subscan</FONT></TD>
                <TD BGCOLOR="#0F2832"><FONT COLOR="#14B6E7"><B>Stellar</B></FONT><BR/><FONT POINT-SIZE="7" COLOR="#64748B">Horizon</FONT></TD>
            </TR>
