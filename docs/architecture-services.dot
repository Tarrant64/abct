    // ========== INFRASTRUCTURE ==========
    infra [label=<
        <TABLE BGCOLOR="#0D2818" BORDER="2" CELLBORDER="0" CELLSPACING="5" CELLPADDING="6" COLOR="#059669" STYLE="ROUNDED">
            <TR><TD COLSPAN="3"><FONT POINT-SIZE="12" COLOR="#10B981"><B>Infrastructure</B></FONT></TD></TR>
