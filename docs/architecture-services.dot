digraph ABCT_Services {
    // === GLOBAL SETTINGS ===
    rankdir=TB;
    splines=true;
    nodesep=0.8;
    ranksep=1.2;
    pad=0.8;
    fontname="Helvetica Neue";
    fontsize=10;
    bgcolor="#0B1120";

    // Title
    labelloc="t";
    label=<<FONT FACE="Helvetica Neue" POINT-SIZE="22" COLOR="#E2E8F0"><B>ABCT</B></FONT><BR/><FONT FACE="Helvetica Neue" POINT-SIZE="13" COLOR="#64748B">Blockchain &amp; Service Map</FONT><BR/><FONT FACE="Helvetica Neue" POINT-SIZE="10" COLOR="#475569">53 Chains  |  42 Exchanges  |  4 NFT Chains  |  120+ Services</FONT>>;

    // Node defaults
    node [
        shape=plain,
        fontname="Helvetica Neue",
        fontsize=9,
        fontcolor="#E2E8F0"
    ];

    edge [
        fontname="Helvetica Neue",
        fontsize=8,
        fontcolor="#94A3B8",
        color="#334155",
        penwidth=1.5,
        arrowsize=0.6
    ];

    // ========== ROUTER HUB ==========
    hub [label=<
        <TABLE BGCOLOR="#0D2818" BORDER="2" CELLBORDER="0" CELLSPACING="6" CELLPADDING="8" COLOR="#34D399" STYLE="ROUNDED">
            <TR><TD COLSPAN="3"><FONT POINT-SIZE="14" COLOR="#34D399"><B>FastAPI Router Hub</B></FONT></TD></TR>
            <TR>
                <TD BGCOLOR="#112F1E"><FONT POINT-SIZE="9" COLOR="#94A3B8">/wallets</FONT></TD>
                <TD BGCOLOR="#112F1E"><FONT POINT-SIZE="9" COLOR="#94A3B8">/portfolio</FONT></TD>
                <TD BGCOLOR="#112F1E"><FONT POINT-SIZE="9" COLOR="#94A3B8">/transactions</FONT></TD>
            </TR>
            <TR>
                <TD BGCOLOR="#112F1E"><FONT POINT-SIZE="9" COLOR="#94A3B8">/nfts</FONT></TD>
                <TD BGCOLOR="#112F1E"><FONT POINT-SIZE="9" COLOR="#94A3B8">/exchanges</FONT></TD>
                <TD BGCOLOR="#112F1E"><FONT POINT-SIZE="9" COLOR="#94A3B8">/prices</FONT></TD>
            </TR>
            <TR>
                <TD BGCOLOR="#112F1E"><FONT POINT-SIZE="9" COLOR="#94A3B8">/defi</FONT></TD>
                <TD BGCOLOR="#112F1E"><FONT POINT-SIZE="9" COLOR="#94A3B8">/analytics</FONT></TD>
                <TD BGCOLOR="#112F1E"><FONT POINT-SIZE="9" COLOR="#94A3B8">/mobile</FONT></TD>
            </TR>
            <TR>
                <TD BGCOLOR="#112F1E"><FONT POINT-SIZE="9" COLOR="#94A3B8">/privacy</FONT></TD>
                <TD BGCOLOR="#112F1E"><FONT POINT-SIZE="9" COLOR="#94A3B8">/pnl</FONT></TD>
                <TD BGCOLOR="#112F1E"><FONT POINT-SIZE="9" COLOR="#94A3B8">/auth</FONT></TD>
            </TR>
            <TR>
                <TD BGCOLOR="#112F1E"><FONT POINT-SIZE="9" COLOR="#94A3B8">/settings</FONT></TD>
                <TD BGCOLOR="#112F1E"><FONT POINT-SIZE="9" COLOR="#94A3B8">+18 more</FONT></TD>
                <TD></TD>
            </TR>
        </TABLE>
    >];

    // ========== L1 MAJOR CHAINS ==========
    chains_l1 [label=<
        <TABLE BGCOLOR="#0D1B22" BORDER="2" CELLBORDER="0" CELLSPACING="5" CELLPADDING="6" COLOR="#06B6D4" STYLE="ROUNDED">
            <TR><TD COLSPAN="3"><FONT POINT-SIZE="12" COLOR="#22D3EE"><B>L1 Major Chains</B></FONT></TD></TR>
            <TR>
                <TD BGCOLOR="#0F2832"><FONT COLOR="#F59E0B"><B>Bitcoin</B></FONT><BR/><FONT POINT-SIZE="7" COLOR="#64748B">Blockstream | Mempool</FONT></TD>
                <TD BGCOLOR="#0F2832"><FONT COLOR="#627EEA"><B>Ethereum</B></FONT><BR/><FONT POINT-SIZE="7" COLOR="#64748B">Alchemy | Etherscan</FONT></TD>
                <TD BGCOLOR="#0F2832"><FONT COLOR="#0088FF"><B>Cardano</B></FONT><BR/><FONT POINT-SIZE="7" COLOR="#64748B">Blockfrost | Maestro</FONT></TD>
            </TR>
            <TR>
                <TD BGCOLOR="#0F2832"><FONT COLOR="#9945FF"><B>Solana</B></FONT><BR/><FONT POINT-SIZE="7" COLOR="#64748B">Helius RPC</FONT></TD>
                <TD BGCOLOR="#0F2832"><FONT COLOR="#4DA2FF"><B>XRP</B></FONT><BR/><FONT POINT-SIZE="7" COLOR="#64748B">XRPL Cluster</FONT></TD>
                <TD BGCOLOR="#0F2832"><FONT COLOR="#EF4444"><B>Tron</B></FONT><BR/><FONT POINT-SIZE="7" COLOR="#64748B">TronGrid (free)</FONT></TD>
            </TR>
        </TABLE>
    >];

