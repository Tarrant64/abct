# ABCT Dashboard - Docker Configuration
# Copy to .env and fill in your values

# ===========================================
# CARDANO - REQUIRED
# ===========================================

# Blockfrost API key for Cardano blockchain access
# Get one at: https://blockfrost.io
BLOCKFROST_API_KEY=your_blockfrost_api_key_here

# ===========================================
# CARDANO - RECOMMENDED
# ===========================================

# CExplorer API key for staking rewards
# Get one at: https://cexplorer.io/api
CEXPLORER_API_KEY=

# Maestro API key (alternative Cardano data)
# Get one at: https://www.gomaestro.org/
MAESTRO_API_KEY=

# ===========================================
# EVM CHAINS (Ethereum/Polygon/Base) - OPTIONAL
# ===========================================

# Alchemy API key for Ethereum/Polygon/Base
# Get one at: https://www.alchemy.com/
ALCHEMY_API_KEY=

# Etherscan API key for transaction history
# Get one at: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Beaconcha.in API key for ETH staking
# Get one at: https://beaconcha.in/api
BEACONCHAIN_API_KEY=

# ===========================================
# SOLANA - OPTIONAL
# ===========================================

# Helius API key for Solana wallet tracking
# Get one at: https://helius.xyz/
HELIUS_API_KEY=

# ===========================================
# PRICING - OPTIONAL
# ===========================================

# CoinGecko API key (optional - uses free tier if not set)
# Get one at: https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# CoinMarketCap API key (fallback pricing)
# Get one at: https://coinmarketcap.com/api/
CMC_API_KEY=

# ===========================================
# NFT IMAGE CACHING - OPTIONAL
# ===========================================

# Enable local caching of NFT images
NFT_IMAGE_CACHE_ENABLED=false

# ===========================================
# OPTIONAL SERVICES
# ===========================================

# Port to expose the dashboard (default: 8080)
ABCT_PORT=8080

# External Cardano NFT price service URL (if running separately)
# Example: http://192.168.1.100:8080
NFT_PRICE_SERVICE_URL=
